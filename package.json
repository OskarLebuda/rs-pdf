{
  "name": "rs-pdf",
  "version": "0.1.11",
  "description": "High-performance PDF to HTML converter — MuPDF via Rust/napi-rs, Node.js bindings",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "keywords": [
    "pdf",
    "html",
    "pdf-to-html",
    "converter",
    "mupdf",
    "rust",
    "napi",
    "native",
    "svg",
    "render",
    "pdf-render",
    "text-extraction",
    "seo",
    "streaming",
    "high-performance",
    "bindings",
    "addon"
  ],
  "scripts": {
    "build:native": "napi build --platform --release --output-dir dist",
    "build:ts": "vp pack",
    "build": "pnpm run build:native && pnpm run build:ts",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "pnpm run build",
    "release": "bumpp package.json npm/*/package.json --commit --tag --push"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.5.1",
    "@types/node": "25.5.0",
    "bumpp": "^9",
    "oxfmt": "0.41.0",
    "oxlint": "1.56.0",
    "typescript": "5.9.3",
    "vite-plus": "0.1.12"
  },
  "optionalDependencies": {
    "rs-pdf-darwin-arm64": "0.1.0",
    "rs-pdf-darwin-x64": "0.1.0",
    "rs-pdf-linux-arm64-gnu": "0.1.0",
    "rs-pdf-linux-x64-gnu": "0.1.0",
    "rs-pdf-win32-x64-msvc": "0.1.0"
  },
  "napi": {
    "binaryName": "rs-pdf",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
